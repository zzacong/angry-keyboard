// Production channel. What CI builds and what people download.
// See docs/adr/0007-distribute-outside-the-app-store.md.

PRODUCT_BUNDLE_IDENTIFIER = com.zzacong.AngryKeyboard
PRODUCT_NAME = AngryKeyboard
INFOPLIST_KEY_CFBundleDisplayName = Angry Keyboard
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Menu bar glyph names, substituted into Config/Info.plist.
AK_MENU_BAR_GLYPH = MenuBarGlyph
AK_MENU_BAR_GLYPH_MUTED = MenuBarGlyphMuted

// Update gate, substituted into Config/Info.plist. Production opts in; the
// updater reads this and starts.
// See docs/adr/0010-in-app-updates-with-sparkle.md.
AK_ENABLE_UPDATES = YES

// Ad-hoc by default, so a clone with no certificate still builds. The optional
// local file, which is gitignored, overrides the identity with the production
// certificate. CI passes the identity on the xcodebuild command line instead.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
#include? "Release.local.xcconfig"
