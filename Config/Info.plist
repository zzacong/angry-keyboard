<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Channel menu bar glyph names. The values come from the per-configuration
	     xcconfig, because custom keys do not survive the generated Info.plist. -->
	<key>AKMenuBarGlyph</key>
	<string>$(AK_MENU_BAR_GLYPH)</string>
	<key>AKMenuBarGlyphMuted</key>
	<string>$(AK_MENU_BAR_GLYPH_MUTED)</string>
	<!-- Update gate. Production substitutes YES, dev NO. Read by UpdatePolicy;
	     the updater is not started yet. -->
	<key>AKEnableUpdates</key>
	<string>$(AK_ENABLE_UPDATES)</string>
	<!-- EdDSA public key Sparkle verifies updates against. The private key is the
	     SPARKLE_PRIVATE_KEY secret, created by Scripts/setup-sparkle-key.sh. -->
	<key>SUPublicEDKey</key>
	<string>AAOBc5/b7krj/V7p75BaXhvKa2uKLbptJsVXjoKAMmE=</string>
	<!-- Update feed, published as a release asset at the repo's stable
	     releases/latest/download path. -->
	<key>SUFeedURL</key>
	<string>https://github.com/zzacong/angry-keyboard/releases/latest/download/appcast.xml</string>
	<!-- Check on a schedule without asking, but never install silently: Sparkle
	     may offer the update, only a click installs it. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
</dict>
</plist>
