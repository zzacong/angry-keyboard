<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Channel menu bar glyph names. The values come from the per-configuration
	     xcconfig, because custom keys do not survive the generated Info.plist. -->
	<key>AKMenuBarGlyph</key>
	<string>$(AK_MENU_BAR_GLYPH)</string>
	<key>AKMenuBarGlyphMuted</key>
	<string>$(AK_MENU_BAR_GLYPH_MUTED)</string>
	<!-- Update gate. Production substitutes YES, dev NO. Read by UpdatePolicy;
	     the updater is not started yet. -->
	<key>AKEnableUpdates</key>
	<string>$(AK_ENABLE_UPDATES)</string>
	<!-- EdDSA public key Sparkle verifies updates against. The private key is the
	     SPARKLE_PRIVATE_KEY secret, created by Scripts/setup-sparkle-key.sh. -->
	<key>SUPublicEDKey</key>
	<string>AAOBc5/b7krj/V7p75BaXhvKa2uKLbptJsVXjoKAMmE=</string>
</dict>
</plist>
