// Dev channel. Debug builds install and run beside the production app.
// See docs/adr/0009-channels-with-separate-identities.md.

PRODUCT_BUNDLE_IDENTIFIER = com.zzacong.AngryKeyboard.dev
PRODUCT_NAME = AngryKeyboardDev
INFOPLIST_KEY_CFBundleDisplayName = Angry Keyboard Dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev

// Menu bar glyph names, substituted into Config/Info.plist. Dev shares
// production's artwork until the blueprint glyph lands; swapping it later is
// these two lines.
AK_MENU_BAR_GLYPH = MenuBarGlyph
AK_MENU_BAR_GLYPH_MUTED = MenuBarGlyphMuted

// Ad-hoc by default, so a clone with no certificate still builds. The optional
// local file, which is gitignored, overrides the identity with the dev
// certificate.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
#include? "Debug.local.xcconfig"
