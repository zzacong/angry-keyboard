---
import * as stylex from "@stylexjs/stylex";
import Deck from "../components/Deck.astro";
import Footer from "../components/Footer.astro";
import GetIt from "../components/GetIt.astro";
import Hero from "../components/Hero.astro";
import Sounds from "../components/Sounds.astro";
import TopBar from "../components/TopBar.astro";
import Layout from "../layouts/Layout.astro";
import { styles } from "../styles/shared.stylex";
---

<Layout>
  <div {...stylex.attrs(styles.page)}>
    <div {...stylex.attrs(styles.wrap)}>
      <TopBar />
      <Hero />
      <Deck />
      <p {...stylex.attrs(styles.lede)}>
        Angry Keyboard is a small macOS app that plays a gunshot on every key
        you press, in whatever app you are in. I built it because my friends
        kept typing on mechanical keyboards and the clacking was driving me up
        the wall. It is a hobby project and I think it is funny.
      </p>
      <Sounds />
      <GetIt />
      <Footer />
    </div>
  </div>
</Layout>
