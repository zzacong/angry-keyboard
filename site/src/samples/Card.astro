---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./card.stylex";

type Props = {
  label: string;
  title: string;
};

const { label, title } = Astro.props;
---

<article {...stylex.attrs(styles.card)}>
  <div {...stylex.attrs(styles.label)}>{label}</div>
  <h3 {...stylex.attrs(styles.title)}>{title}</h3>
  <p {...stylex.attrs(styles.body)}>
    <slot />
  </p>
</article>
