---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./tabs.stylex";

type Props = {
  tabs: Array<{ label: string; body: string }>;
  selected?: number;
};

const { tabs, selected = 0 } = Astro.props;
---

<div {...stylex.attrs(styles.root)} role="tablist">
  {tabs.map((tab, index) => (
    <button
      type="button"
      role="tab"
      aria-selected={index === selected}
      {...stylex.attrs(styles.tab, index === selected && styles.selected)}
    >
      {tab.label}
    </button>
  ))}
</div>
<div {...stylex.attrs(styles.panel)}>{tabs[selected]?.body}</div>
