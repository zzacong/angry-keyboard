---
// StyleX serves its rules from a virtual endpoint in dev, and Astro does not
// run Vite's HTML transform, so link the stylesheet and the HMR runtime by
// hand. Renders nothing in a production build, where the plugin appends the
// extracted rules to the CSS asset instead.
---

{import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
{import.meta.env.DEV && (
  <script is:inline type="module" src="/@id/virtual:stylex:runtime" />
)}
