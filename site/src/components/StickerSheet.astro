---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./stickerSheet.stylex";

// The same flat set as the scattered decor, laid out as a sheet. Rotations are
// hand-picked to read scattered rather than following a rule.
const stickers = [
  { box: "0 0 170 156", id: "s-boom", rot: -8 },
  { box: "0 0 132 156", id: "s-grenade", rot: 6 },
  { box: "0 0 196 110", id: "s-missile", rot: 11 },
  { box: "0 0 150 150", id: "s-bomb", rot: -6 },
  { box: "0 0 90 170", id: "s-bullet", rot: 8 },
  { box: "0 0 190 130", id: "s-crate", rot: -10 },
  { box: "0 0 170 156", id: "s-pow", rot: 5 },
  { box: "0 0 152 140", id: "s-fist", rot: 12 },
  { box: "0 0 160 148", id: "s-hazard", rot: -7 },
  { box: "0 0 130 130", id: "s-free", rot: 6 },
];
---

<div {...stylex.attrs(styles.sheet)}>
  <p {...stylex.attrs(styles.note)}>the sticker sheet</p>
  <div {...stylex.attrs(styles.row)} aria-hidden="true">
    {stickers.map((sticker) => (
      <svg
        viewBox={sticker.box}
        {...stylex.attrs(styles.sticker, styles.stickerRot(sticker.rot))}
      >
        <use href={`#${sticker.id}`} />
      </svg>
    ))}
  </div>
</div>
