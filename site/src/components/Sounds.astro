---
import * as stylex from "@stylexjs/stylex";
import { styles } from "@/components/sounds.stylex";
import { KEY_BINDINGS } from "@/lib/key-bindings";
import { styles as shared } from "@/styles/shared.stylex";
---

<section id="f-sounds" {...stylex.attrs(styles.section)}>
  <div {...stylex.attrs(shared.decor)} aria-hidden="true">
    <svg viewBox="0 0 190 130" {...stylex.attrs(shared.fst, styles.crate)}>
      <use href="#s-crate" />
    </svg>
    <svg viewBox="0 0 152 140" {...stylex.attrs(shared.fst, styles.fist)}>
      <use href="#s-fist" />
    </svg>
  </div>

  <div {...stylex.attrs(shared.above)}>
    <h2 {...stylex.attrs(styles.title)}>The sounds</h2>
    <p {...stylex.attrs(styles.sub)}>
      Six rules, one of them a catch-all for every key without its own sound.
    </p>
  </div>

  <ul {...stylex.attrs(styles.list, shared.above)}>
    {KEY_BINDINGS.map((binding) => (
      <li {...stylex.attrs(styles.item)}>
        <span {...stylex.attrs(styles.box)}></span>
        {binding.soundKey}
        <span {...stylex.attrs(styles.sound)}>{binding.sound}</span>
      </li>
    ))}
  </ul>
</section>
