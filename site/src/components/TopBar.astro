---
import * as stylex from "@stylexjs/stylex";
import { styles } from "@/components/topBar.stylex";
import { repoUrl } from "@/lib/links";
---

<div {...stylex.attrs(styles.top)}>
  <span {...stylex.attrs(styles.name)}>Angry Keyboard</span>
  <nav {...stylex.attrs(styles.nav)}>
    <a href="#f-try" {...stylex.attrs(styles.link)}>
      Try it
    </a>
    <a href="#f-sounds" {...stylex.attrs(styles.link)}>
      Sounds
    </a>
    <a href="#f-get" {...stylex.attrs(styles.link)}>
      Get it
    </a>
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener"
      {...stylex.attrs(styles.link)}
    >
      <svg aria-hidden="true" {...stylex.attrs(styles.mark)}>
        <use href="#gh-mark" />
      </svg>
      GitHub
    </a>
  </nav>
</div>
